# ===== Hello-RAG 环境变量 / Environment Variables =====
# 本项目基于 OpenAI 兼容接口，可用任意兼容服务（OpenAI、火山引擎、OrcaRouter 等）。
# This project uses an OpenAI-compatible interface, so any compatible service works.

# 可选 LLM 网关 — OrcaRouter（零加价，200+ 模型，一个端点）
# Optional LLM gateway — OrcaRouter (zero markup, 200+ models, one endpoint)
# 申请 Key / Get an API key: https://www.orcarouter.ai/ref/ref_007610f54c1e5ca8be45
LLM_BASE_URL=https://api.orcarouter.ai/v1
LLM_API_KEY=sk-orca-...
LLM_MODEL_ID=orcarouter/auto

# 嵌入模型（部分章节需要）/ Embedding model (used by some chapters)
# OrcaRouter 亦提供 embeddings 接口，可填任意支持的嵌入模型
# OrcaRouter also exposes an embeddings API; use any supported embedding model.
EMBEDDING_MODEL_ID=<your-embedding-model>

# OrcaRouter 专用（可选，provider 配置用）/ OrcaRouter-specific (optional)
ORCAROUTER_API_KEY=sk-orca-...
